# ══════════ 服务基础 ══════════
# 服务端口（被占用时改这里）
PORT=3000
# 监听地址：0.0.0.0 允许局域网内手机/其他电脑访问；仅本机用改 127.0.0.1
HOST=0.0.0.0

# ══════════ 登录鉴权（默认关闭，开箱即用） ══════════
# true = 开启登录页；false = 免登录直接访问
AUTH_ENABLED=true
# 管理员账号（开启鉴权后生效）
ADMIN_USER=admin
# 明文密码（仅开发/内网使用）
ADMIN_PASS=admin123
# 生产环境推荐：bcrypt 密码哈希（设置后明文密码失效）
# 生成方式：npm run gen-hash -- 你的密码
ADMIN_PASS_HASH=
# JWT 签名密钥：生产环境务必改成一串随机长字符
JWT_SECRET=please-change-me-to-a-long-random-string

# ══════════ 大模型接入（可选） ══════════
# 填全以下三项后，服务端将代理大模型请求（密钥保存在服务器，浏览器不可见）
# 兼容 OpenAI Chat Completions 格式的接口均可（OpenAI / DeepSeek / 通义 / 智谱 / 本地 vLLM 等）
LLM_BASE=
LLM_KEY=
LLM_MODEL=

# ══════════ 数据 ══════════
# 数据目录（默认 ./data，一般不用改）
DATA_DIR=

# ══════════ 运行环境 ══════════
NODE_ENV=production
